{
  "pass": 2,
  "system": {
    "id": "sys:decreen-dot-github",
    "label": "Decreen .github repository (GitHub-hosted)"
  },
  "containers": [
    {"id": "container:repository-tree", "label": "Version-controlled repository tree (files and directories)"}
  ],
  "exclusions": [
    {"id": "candidate:relational-database", "reason": "No database drivers, connection strings, or schema migrations found in source or config files."},
